# Optional LLM fallback (off by default — regex + manufacturer fetch handle most rows)
# UNILOG_LLM_ENABLED=1
# OPENAI_API_KEY=sk-...
# UNILOG_LLM_MODEL=gpt-4o-mini
# UNILOG_LLM_MAX_CALLS=50
# UNILOG_LLM_MAX_DESC_CHARS=100
# UNILOG_LLM_MAX_OUTPUT_TOKENS=80

# Optional shared URL memory across Vercel visitors (Judge 1 teaches Judge 2).
# Create a free Upstash Redis database, then set both:
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Or a Vercel Blob token: BLOB_READ_WRITE_TOKEN=vercel_blob_...
# UNILOG_SHARED_MEMORY=0 disables the store even if tokens are present.
