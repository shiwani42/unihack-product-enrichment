{
  "$comment": "Declarative walkthrough plan for unilog live capture. Segment times are filled in by capture_walkthrough.py after a successful take (recordings/walkthrough_meta.json is authoritative).",
  "base_url": "http://localhost:8000",
  "viewport": { "width": 1920, "height": 1080 },
  "fps": 30,
  "output": "walkthrough.mp4",
  "raw_output": "walkthrough_raw.webm",
  "segments": [
    { "id": "seg-hero", "label": "Hero load: Enrich workbench" },
    { "id": "seg-enrich", "label": "Type part line and enrich PDSH4816AF" },
    { "id": "seg-catalog-drawer", "label": "Catalog row -> drawer -> Evidence (sources + honest blanks), close via Escape" },
    { "id": "seg-batch", "label": "Run batch stream (1000 SKUs) to completion" },
    { "id": "seg-proof", "label": "Reference proof band: click reference SKU, re-enrich" },
    { "id": "seg-export", "label": "Export CSV download from catalog" }
  ],
  "actions": [
    { "label": "load-hero", "expect": { "text": "Enrich" } },
    { "label": "proof-band-visible", "target": "#proof-band" },
    { "label": "type-mpn", "target": "#sb_mpn", "value": "PDSH4816AF" },
    { "label": "type-desc", "target": "#sb_desc", "value": "24in built-in dishwasher" },
    { "label": "click-enrich", "target": "#sbEnrichBtn", "expect": { "selector-detached": "#sb-result-container .wb-empty" } },
    { "label": "nav-catalog", "target": "[data-page=\"catalog\"]" },
    { "label": "open-drawer", "target": "#results-body tr[data-mpn]", "expect": { "selector": "#drawer.open" } },
    { "label": "tab-evidence", "target": "[data-dtab=\"evidence\"]", "expect": { "text-nonempty": "#dtab-evidence" } },
    { "label": "close-drawer-esc", "expect": { "key": "Escape" } },
    { "label": "nav-batch", "target": "[data-page=\"enrich\"]" },
    { "label": "set-limit-1000", "target": "#sampleLimit", "value": "1000" },
    { "label": "click-run-batch", "target": "#liveBtn", "expect": { "text-prefix": "#progress-message|Complete" } },
    { "label": "proof-band-shown", "target": "#proof-band" },
    { "label": "click-reference-sku", "target": "#proof-band button" },
    { "label": "reference-sku-enriched", "expect": { "selector-detached": "#sb-result-container .skeleton" } },
    { "label": "nav-catalog-export", "target": "[data-page=\"catalog\"]" },
    { "label": "click-csv-download", "target": ".export-group a[href=\"/download/csv\"]", "download": true }
  ]
}
